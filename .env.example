# Copy to .env locally; never commit the real file or credentials.
PRODUCER_PORT=3101
CONSUMER_PORT=3102
PRODUCER_BASE_URL=http://127.0.0.1:3101
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# A real commit SHA when available; "local-uncommitted" is deliberately not a release.
APP_REVISION=local-uncommitted
# Set on the consumer before exposing /report on the public internet.
LAB_API_TOKEN=
